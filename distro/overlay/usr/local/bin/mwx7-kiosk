#!/bin/sh
# Starts cage (single-app Wayland compositor) running Chromium full screen on MWX 7.
# stdin is tty1 (opened read-write by systemd), so messages printed there are what the person at the screen sees
# until the compositor takes over.
say() { { printf '\033[2J\033[H\n\n'; for l in "$@"; do printf '    %s\n' "$l"; done; } >&0 2>/dev/null || true; }
say 'Starting MWX 7 ...'

# Wait for the local server so Chromium never shows an error page on a slow boot.
for i in $(seq 1 50); do
  python3 -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8080/', timeout=1)" 2>/dev/null && break
  sleep 0.2
done

# The compositor needs a display device. GPU drivers and the simpledrm fallback can take a few seconds to appear.
for i in $(seq 1 50); do
  ls /dev/dri/card* >/dev/null 2>&1 && break
  sleep 0.2
done
if ! ls /dev/dri/card* >/dev/null 2>&1; then
  say 'MWX 7 could not find a display device.' '' \
    'In VirtualBox: Settings > System > tick "Enable EFI", or Settings > Display > Graphics Controller: VMSVGA.' '' \
    'On a PC: start the second boot entry, or try another graphics output.' '' \
    "Details: $(lspci 2>/dev/null | grep -iE 'vga|display' | head -1)"
  sleep 30
  exit 1
fi

# seatd (socket group video, which the mwx user is in) opens the GPU and input devices for cage.
export LIBSEAT_BACKEND=seatd
export WLR_NO_HARDWARE_CURSORS=1
# VMs and GPUs without a driver only offer software rendering; let wlroots use it rather than refuse to start.
export WLR_RENDERER_ALLOW_SOFTWARE=1
# If the GL path crashed on the previous try (seen with Mesa's software GL in emulated VMs), use wlroots' CPU
# renderer instead. The marker lives in /run, so every boot tries the faster GPU path first.
RUN=/run/user/$(id -u)
SW=$RUN/mwx7-pixman
[ -f "$SW" ] && export WLR_RENDERER=pixman
START=$(date +%s)
# Chromium can come up with a blank page when its network service crashes during a cold first start. The server marks
# the moment MWX 7's JavaScript is requested; if that has not happened in time, restart Chromium. Each retry waits
# longer, so a slow machine is never cut off for good.
TRIES=$(cat "$RUN/mwx7-tries" 2>/dev/null || echo 0); echo $((TRIES + 1)) > "$RUN/mwx7-tries"
LIMIT=$((60 << (TRIES > 3 ? 3 : TRIES)))
rm -f /run/mwx7/loaded 2>/dev/null
# -s allows VT switching (Ctrl+Alt+F2 reaches the debug console).
cage -s -- chromium \
  --kiosk --no-first-run --no-default-browser-check --disable-infobars \
  --ozone-platform=wayland --autoplay-policy=no-user-gesture-required \
  --disable-pinch --overscroll-history-navigation=0 --user-data-dir=/tmp/mwx7-profile \
  http://127.0.0.1:8080/ 2> "$RUN/mwx7-cage.log" &
CAGE=$!
(
  for i in $(seq 1 "$LIMIT"); do
    [ -e /run/mwx7/loaded ] && { echo 0 > "$RUN/mwx7-tries"; exit 0; }
    kill -0 "$CAGE" 2>/dev/null || exit 0
    sleep 1
  done
  echo "MWX 7 did not load within ${LIMIT}s, restarting Chromium" >&2
  kill "$CAGE" 2>/dev/null
) &
wait "$CAGE"
CODE=$?
if [ $(( $(date +%s) - START )) -lt 15 ]; then
  touch "$SW"
  # Count quick failures so a display that never works ends on a readable message, not a silent restart loop.
  n=$(( $(cat "$RUN/mwx7-fails" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$RUN/mwx7-fails"
  if [ "$n" -ge 3 ]; then
    say 'MWX 7 could not start its display.' '' "$(grep -m1 -E 'ERROR|rror' "$RUN/mwx7-cage.log" | cut -c1-110)"
    sleep 30
  fi
fi
cat "$RUN/mwx7-cage.log" >&2
exit $CODE
