#!/usr/bin/python3
"""Static file server for MWX 7 on 127.0.0.1:8080 (offline). It also drops a marker in /run/mwx7 the first time the
page's JavaScript is requested, so the kiosk can tell "Chromium really loaded MWX 7" apart from "Chromium is up but
stuck on a blank page", and restart it in the second case."""
import functools
import http.server
import os
import sys

MARK = '/run/mwx7/loaded'


class Handler(http.server.SimpleHTTPRequestHandler):
    def do_GET(self):
        if self.path.startswith('/assets/') and self.path.endswith('.js') and not os.path.exists(MARK):
            try:
                open(MARK, 'w').close()
            except OSError:
                pass
        super().do_GET()

    def log_message(self, fmt, *args):  # one line per request on stderr (journal + serial console)
        sys.stderr.write('%s - %s\n' % (self.address_string(), fmt % args))


http.server.ThreadingHTTPServer(('127.0.0.1', 8080), functools.partial(Handler, directory='/opt/mwx7/dist')).serve_forever()
