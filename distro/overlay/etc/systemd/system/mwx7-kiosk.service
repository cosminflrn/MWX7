[Unit]
Description=MWX 7 kiosk session (cage + Chromium on tty1)
After=systemd-user-sessions.service mwx7-server.service systemd-logind.service seatd.service
Wants=mwx7-server.service seatd.service
# Replace the login prompt on tty1.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=mwx
# PAMName makes logind create a seat session + /run/user/<uid> (needed by Wayland and DRM access).
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/usr/local/bin/mwx7-kiosk
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
