// MWX 7: the person at the screen may change the time zone, and an administrator (the account made at setup) installs
// updates from Settings without typing the password each time, like on Windows.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.timedate1.set-timezone" && subject.local && subject.active) {
    return polkit.Result.YES;
  }
  if (action.id == "org.mwx7.update" && subject.local && subject.active && subject.isInGroup("sudo")) {
    return polkit.Result.YES;
  }
});
