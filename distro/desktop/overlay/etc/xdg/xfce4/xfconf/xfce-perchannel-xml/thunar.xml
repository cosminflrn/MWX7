<?xml version="1.0" encoding="UTF-8"?>
<!-- MWX 7 defaults for Files (Thunar reads system defaults from here; a user's own changes are kept in ~/.config). -->
<channel name="thunar" version="1.0">
  <!-- "Documents", not "Documents - Thunar": the window frame already says which app it is by its icon. -->
  <property name="misc-window-title-style" type="string" value="THUNAR_WINDOW_TITLE_STYLE_FOLDER_NAME_WITHOUT_THUNAR_SUFFIX"/>
  <property name="default-view" type="string" value="ThunarIconView"/>
  <property name="last-view" type="string" value="ThunarIconView"/>
  <property name="misc-single-click" type="bool" value="false"/>
  <property name="last-show-hidden" type="bool" value="false"/>
  <property name="misc-show-delete-action" type="bool" value="true"/>
</channel>
