// MWX 7 only refreshes the list of available updates (quietly, for the status bar's update icon). Nothing installs by
// itself: updates install when the person chooses (Settings -> Updates, or "Update and shut down").
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "0";
APT::Periodic::AutocleanInterval "7";
