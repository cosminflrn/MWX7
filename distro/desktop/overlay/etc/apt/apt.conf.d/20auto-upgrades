// Security fixes install by themselves, quietly, once a day (51mwx7-unattended says which). Everything else waits
// for the person: the status bar's update icon, Settings -> Updates, or "Update and shut down".
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";
