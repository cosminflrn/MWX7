#!/usr/bin/env python3
"""Keeps a user's ~/.config/mwx7/wayfire.ini current. MWX 7 releases change the system defaults in /etc/mwx7 (new
plugins, new options); a copy made by an older release would hide them. When the copy is from another release it is
rebuilt from the current defaults, keeping what the person chose in MWX 7 Settings."""
import os
import re
import subprocess
import sys

SYSTEM = '/etc/mwx7/wayfire.ini'
VERSION_FILE = '/usr/share/mwx7/version'
STAMP = '# mwx7-defaults:'
# What MWX 7 Settings changes, so what a person can have chosen. Every [output:...] section is theirs too.
KEPT = {'decoration': ('active_color', 'inactive_color'),
        'input': ('xkb_layout', 'xkb_variant', 'kb_repeat_delay', 'kb_repeat_rate', 'mouse_cursor_speed',
                  'mouse_natural_scroll', 'left_handed_mode', 'cursor_size'),
        'zoom': ('modifier',)}


# Window colours MWX 7 Settings offered before 1.9.0.209 (opaque pastel frames).
OLD_COLORS = {'\\#' + c for c in ('9CC4ECC0', 'D2DEEBB0', '7FA3D6C8', 'C3D0E3B0', '86D0D8C0', 'CFE3E6B0', 'A8D99AC0',
                                  'D6E6D1B0', 'B9A9E3C0', 'DCD6EDB0', 'EDB0C4C0', 'EED8E0B0', 'F2D27EC0', 'F1E6C8B0',
                                  'A9B3BEC8', 'D5D9DEB0')}


def sections(text):
    """{name: (start, end)} of each section body."""
    out = {}
    for m in re.finditer(r'^\[([^\]]+)\]\s*$(.*?)(?=^\[|\Z)', text, re.M | re.S):
        out[m.group(1)] = m.group(2)
    return out


def get(body, key):
    m = re.search(r'^' + re.escape(key) + r'\s*=\s*(.*)$', body, re.M)
    return m.group(1).rstrip() if m else None


def put(text, section, key, value):
    line = f'{key} = {value}'
    m = re.search(r'^\[' + re.escape(section) + r'\]\s*$(.*?)(?=^\[|\Z)', text, re.M | re.S)
    if not m:
        return text.rstrip('\n') + f'\n\n[{section}]\n{line}\n'
    body = m.group(1)
    if re.search(r'^' + re.escape(key) + r'\s*=.*$', body, re.M):
        body = re.sub(r'^' + re.escape(key) + r'\s*=.*$', lambda _m: line, body, count=1, flags=re.M)
    else:
        body = '\n' + line + body if body.startswith('\n') else '\n' + line + '\n' + body
    return text[:m.start(1)] + body + text[m.end(1):]


def main(user):
    version = open(VERSION_FILE).read().strip()
    system = open(SYSTEM).read()
    stamp = f'{STAMP} {version}\n'
    try:
        old = open(user).read()
    except FileNotFoundError:
        old = None
    if old is not None and old.startswith(stamp):
        new = old
    else:
        new = merged(stamp + system, old)
        # Settings -> Ease of Access adds the magnifier (zoom) to the plugin list; keep it across a rebuild.
        mine, theirs = get(sections(old or '').get('core', ''), 'plugins'), get(sections(new).get('core', ''), 'plugins')
        if mine and theirs and 'zoom' in mine.split() and 'zoom' not in theirs.split():
            new = put(new, 'core', 'plugins', theirs + ' zoom')
    new = for_this_machine(new, system)
    if new == old:
        return
    os.makedirs(os.path.dirname(user), exist_ok=True)
    tmp = user + '.tmp'
    with open(tmp, 'w') as f:
        f.write(new)
    os.replace(tmp, user)


def in_vm():
    try:
        return subprocess.run(['systemd-detect-virt', '--vm'], capture_output=True, text=True,
                              timeout=5).stdout.strip() not in ('', 'none')
    except (OSError, subprocess.TimeoutExpired):
        return False


def for_this_machine(text, system):
    """Glass is blurred everywhere again (1.9.0.207 left windows unblurred in virtual machines): the system default."""
    full = get(sections(system).get('blur', ''), 'blur_by_default')
    text = put(text, 'blur', 'blur_by_default', full) if full else text
    # Key bindings added in later releases reach copies that are already stamped for this version (a dev build).
    for key, value in COMMAND_KEYS(system, text):
        text = put(text, 'command', key, value)
    # Bindings the system owns (Settings does not change them): always the current ones, or an old Super alone for the
    # overview would clash with the Start menu's.
    for sec, keys in SYSTEM_KEYS.items():
        for key in keys:
            v = get(sections(system).get(sec, ''), key)
            if v is not None and get(sections(text).get(sec, ''), key) != v:
                text = put(text, sec, key, v)
    return text


# Keyboard shortcuts and the Alt+Tab switcher's look: owned by the system defaults.
SYSTEM_KEYS = {
    'core': ('close_top_view',),
    'switcher': ('next_view', 'prev_view', 'speed', 'view_thumbnail_scale', 'view_thumbnail_rotation'),
    'fast-switcher': ('activate', 'activate_backward'),
    'wm-actions': ('toggle_showdesktop',),
    'scale': ('toggle',),
    'command': ('binding_snip', 'command_snip', 'binding_snipfull', 'command_snipfull', 'binding_snipwin',
                'command_snipwin'),
    'grid': ('slot_l', 'slot_r', 'slot_c', 'restore'),
}


def COMMAND_KEYS(system, text):
    """[command] entries of the system defaults for the shell flyouts and shortcuts that the user's copy lacks."""
    mine = sections(text).get('command', '')
    out = []
    for name in ('clipboard', 'search', 'start', 'dock', 'tray', 'computer', 'snip', 'snipfull', 'snipwin'):
        for prefix in ('binding_', 'command_'):
            v = get(sections(system).get('command', ''), prefix + name)
            if v is not None and get(mine, prefix + name) is None:
                out.append((prefix + name, v))
    return out


def merged(new, old):
    if old is not None:
        mine = sections(old)
        for sec, keys in KEPT.items():
            for k in keys:
                v = get(mine.get(sec, ''), k)
                if v in OLD_COLORS:  # the pastel frames before Aero glass: the new default instead
                    continue
                if v is not None:
                    new = put(new, sec, k, v)
        for sec, body in mine.items():
            if sec.startswith('output:'):
                for line in body.splitlines():
                    if '=' in line and not line.lstrip().startswith('#'):
                        k, v = line.split('=', 1)
                        new = put(new, sec, k.strip(), v.strip())
    return new


if __name__ == '__main__':
    main(sys.argv[1])
