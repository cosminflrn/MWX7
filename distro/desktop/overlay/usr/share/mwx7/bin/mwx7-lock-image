#!/usr/bin/env python3
"""Draws the lock screen background like the MWX 7 logon screen: wallpaper, the account picture in its glossy frame,
the name, and "Locked" — swaylock draws only its password ring on top, just below the name, where the logon screen
has its password field. Cached per wallpaper and size; prints the path."""
import hashlib
import os
import pwd
import subprocess
import sys

import gi
gi.require_version('GdkPixbuf', '2.0')
gi.require_version('Gdk', '4.0')
gi.require_version('PangoCairo', '1.0')
from gi.repository import GdkPixbuf, Gdk, Pango, PangoCairo  # noqa: E402,F401
import cairo  # noqa: E402

W, H = int(sys.argv[1]), int(sys.argv[2])
wall = sys.argv[3]
user = pwd.getpwuid(os.getuid())
name = (user.pw_gecos or '').split(',')[0].strip() or user.pw_name.capitalize()
pic = f'/var/lib/AccountsService/icons/{user.pw_name}'
if not os.path.exists(pic):
    pic = '/usr/share/mwx7/avatars/03-guitar.jpg'
# An account without a password unlocks with Enter alone; say so, since there is nothing to type.
try:
    nopass = subprocess.run(['passwd', '-S'], capture_output=True, text=True, timeout=3).stdout.split()[1] == 'NP'
except (OSError, IndexError, subprocess.TimeoutExpired):
    nopass = False
status = 'Locked · press Enter to unlock' if nopass else 'Locked'
cache = os.path.join(os.environ.get('XDG_CACHE_HOME', os.path.expanduser('~/.cache')), 'mwx7')
os.makedirs(cache, exist_ok=True)
key = hashlib.sha1(f'{wall}|{os.path.getmtime(wall)}|{pic}|{name}|{status}|{W}x{H}|2'.encode()).hexdigest()[:16]
out = os.path.join(cache, f'lock-{key}.png')
if os.path.exists(out):
    print(out)
    sys.exit(0)

s = cairo.ImageSurface(cairo.FORMAT_RGB24, W, H)
c = cairo.Context(s)
# wallpaper, cover-fit like the logon screen
bg = GdkPixbuf.Pixbuf.new_from_file(wall)
k = max(W / bg.get_width(), H / bg.get_height())
bw, bh = int(bg.get_width() * k + 0.5), int(bg.get_height() * k + 0.5)
bg = bg.scale_simple(bw, bh, GdkPixbuf.InterpType.BILINEAR)
Gdk.cairo_set_source_pixbuf(c, bg, (W - bw) / 2, (H - bh) / 2)
c.paint()

cx, size = W / 2, 112
top = H / 2 - 150  # picture, then name, then the ring below the middle
def rounded(x, y, w, h, r):
    c.new_sub_path()
    c.arc(x + w - r, y + r, r, -1.5708, 0); c.arc(x + w - r, y + h - r, r, 0, 1.5708)
    c.arc(x + r, y + h - r, r, 1.5708, 3.1416); c.arc(x + r, y + r, r, 3.1416, 4.7124); c.close_path()
# shadow, frame, picture
for i in range(10, 0, -1):
    c.set_source_rgba(0, 0.08, 0.24, 0.035)
    rounded(cx - size / 2 - 6 - i, top - 6 - i + 4, size + 12 + 2 * i, size + 12 + 2 * i, 10 + i)
    c.fill()
g = cairo.LinearGradient(0, top - 6, 0, top + size + 6)
g.add_color_stop_rgba(0, 1, 1, 1, 0.97); g.add_color_stop_rgba(1, 0.84, 0.91, 0.98, 0.92)
c.set_source(g); rounded(cx - size / 2 - 6, top - 6, size + 12, size + 12, 10); c.fill()
p = GdkPixbuf.Pixbuf.new_from_file_at_scale(pic, size, size, False)
c.save(); rounded(cx - size / 2, top, size, size, 4); c.clip()
Gdk.cairo_set_source_pixbuf(c, p, cx - size / 2, top); c.paint(); c.restore()

def text(t, y, px, alpha, weight='Regular'):
    lay = PangoCairo.create_layout(c)
    lay.set_font_description(Pango.FontDescription(f'Selawik {weight} {px}px'))
    lay.set_text(t, -1)
    tw, th = lay.get_pixel_size()
    for dx, dy, a in ((0, 1, 0.9), (0, 0, 0.5)):
        c.move_to(cx - tw / 2 + dx, y + dy); c.set_source_rgba(0, 0.08, 0.24, a * 0.55)
        PangoCairo.layout_path(c, lay); c.fill()
    c.move_to(cx - tw / 2, y); c.set_source_rgba(1, 1, 1, alpha); PangoCairo.show_layout(c, lay)
text(name, top + size + 18, 24, 1.0)
text(status, top + size + 52, 14, 0.85)
s.write_to_png(out + '.tmp')
os.replace(out + '.tmp', out)
print(out)
