#!/bin/bash
# mwx7-keep-settings /dev/DISK — turns a completely blank disk into the place where the live MWX 7 keeps your home
# folder (settings, Chrome profile, files) and Wi-Fi networks, so they survive restarts without installing.
# It refuses anything that is not blank: no partitions, no filesystem or partition-table signature, not the boot disk.
set -euo pipefail
LABEL=mwx7-data
DEV=${1:-}
die() { echo "$*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "Run as root."
[ -b "$DEV" ] || die "$DEV is not a disk."
[ "$(lsblk -dno TYPE "$DEV")" = disk ] || die "$DEV is not a whole disk."
[ "$(lsblk -no NAME "$DEV" | wc -l)" = 1 ] || die "$DEV has partitions; only a blank disk can be used."
[ -z "$(wipefs -n -O TYPE --noheadings "$DEV")" ] || die "$DEV is not blank (it holds a filesystem or partition table)."
boot=$(findmnt -no SOURCE /run/live/medium 2>/dev/null || true)
[ -n "$boot" ] && [ "$(lsblk -no PKNAME "$boot" 2>/dev/null | head -1)" = "$(basename "$DEV")" ] && die "$DEV is the disk MWX 7 started from."
[ "$(lsblk -bdno SIZE "$DEV")" -ge 2000000000 ] || die "$DEV is smaller than 2 GB."

echo 'type=linux' | sfdisk --quiet --label gpt "$DEV"
udevadm settle
PART=/dev/$(lsblk -nro NAME "$DEV" | sed -n 2p)
[ -b "$PART" ] || die "The new partition did not appear."
mkfs.ext4 -q -F -L "$LABEL" "$PART"
MNT=$(mktemp -d)
mount "$PART" "$MNT"
trap 'umount "$MNT"; rmdir "$MNT"' EXIT
# Only the home folders and Wi-Fi networks persist: the rest of the system always comes fresh from the ISO, so booting
# a newer MWX 7 ISO with the same disk gets every update and keeps your things.
cat > "$MNT/persistence.conf" <<'CONF'
/home union
/etc/NetworkManager/system-connections union
CONF
# What changed in this session so far moves over too, so nothing set up before pressing the button is lost.
# live-boot keeps each union's changes in <dir>/rw (and its scratch space in <dir>/work).
for d in home etc/NetworkManager/system-connections; do
  mkdir -p "$MNT/$d/rw" "$MNT/$d/work"
  if [ -d "/run/live/overlay/rw/$d" ]; then rsync -a "/run/live/overlay/rw/$d/" "$MNT/$d/rw/"; fi
done
sync
echo "ok $PART"
