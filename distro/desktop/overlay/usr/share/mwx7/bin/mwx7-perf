#!/usr/bin/python3
"""At sign-in: without 3D acceleration (VMware with "Accelerate 3D graphics" off, llvmpipe) the processor draws every
frame, and the Aero blur behind each window is what makes moving windows lag. Then the glass stays, unblurred; the
blur comes back by itself on the first sign-in with acceleration. VMware counts as no acceleration here."""
import json
import os
import sys

sys.path.insert(0, '/usr/share/mwx7/settings')
import settings as base  # noqa: E402

STATE = os.path.join(base.CONF_DIR, 'perf.json')
def vmware():
    """VMware's virtual GPU (vmwgfx) passes GL through to the host slowly: the Aero blur, redrawn behind every window
    and the bar on each frame, is what made MWX 7 lag there even with 3D acceleration on (13 Nov 2026)."""
    import glob
    return any(os.path.basename(os.path.realpath(d)) == 'vmwgfx' for d in glob.glob('/sys/class/drm/card*/device/driver'))


soft = base.Settings.acceleration().startswith('Off') or vmware()
try:
    saved = json.load(open(STATE))
except (OSError, ValueError):
    saved = None
blur = base.ini_get('blur', 'blur_by_default')
plugins = base.ini_get('core', 'plugins').split()
if soft:
    # Every sign-in: mwx7-config-merge puts the default blur back before Wayfire starts, so checking only the first
    # time (as before) left VMware blurred from the second sign-in on.
    state = dict(saved or {})
    if blur and blur != 'none':
        state.setdefault('blur_by_default', blur)
        base.ini_set('blur', 'blur_by_default', 'none')
    # Unloaded, not just idle: Wayfire's blur grows the damage of every repaint by its radius (21 px each side here)
    # even when it blurs nothing, so hovering a traffic light redrew ten times its area; and windows mapped before
    # this runs (the bar, the dock) keep their blur until the plugin goes.
    if 'blur' in plugins:
        state['blur_plugin'] = True
        base.ini_set('core', 'plugins', ' '.join(p for p in plugins if p != 'blur'))
    if state != saved:
        with open(STATE, 'w') as f:
            json.dump(state, f)
elif saved is not None:
    if saved.get('blur_plugin') and plugins and 'blur' not in plugins:
        at = plugins.index('autostart') + 1 if 'autostart' in plugins else len(plugins)  # where the defaults have it
        base.ini_set('core', 'plugins', ' '.join(plugins[:at] + ['blur'] + plugins[at:]))
    if saved.get('blur_by_default') and base.ini_get('blur', 'blur_by_default') == 'none':
        base.ini_set('blur', 'blur_by_default', saved['blur_by_default'])
    os.unlink(STATE)

# Animations: Reduced (short fades only) on VMware or software drawing, Full again once there is real acceleration.
# A level the user picked in Settings (animations.json) is never touched; perf-animations.json remembers what we replaced.
ANIM_USER = os.path.join(base.CONF_DIR, 'animations.json')
ANIM_AUTO = os.path.join(base.CONF_DIR, 'perf-animations.json')
if not os.path.exists(ANIM_USER):
    level = base.ini_get('mwx7-animate', 'level', 'full')
    if soft and not os.path.exists(ANIM_AUTO) and level == 'full':
        with open(ANIM_AUTO, 'w') as f:
            json.dump({'level': level}, f)
        base.ini_set('mwx7-animate', 'level', 'reduced')
    elif not soft and os.path.exists(ANIM_AUTO):
        if level == 'reduced':
            base.ini_set('mwx7-animate', 'level', 'full')
        os.unlink(ANIM_AUTO)
