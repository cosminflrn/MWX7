#!/bin/sh
# Locks the screen with mwx7-lockscreen (ext-session-lock client: clock, picture, password field, power buttons).
# It returns once the screen is locked. If it cannot lock (exit 3, e.g. the GTK session-lock library is missing), the
# old swaylock screen is the fallback, so the screen never stays unlocked because of a missing piece.
pgrep -u "$(id -u)" -x swaylock >/dev/null && exit 0
pgrep -u "$(id -u)" -f '[m]wx7-lockscreen' >/dev/null && exit 0
/usr/share/mwx7/bin/mwx7-lockscreen && exit 0
exec /usr/share/mwx7/bin/mwx7-lock-swaylock
