#!/usr/bin/python3
"""Settings -> Account, run as root through pkexec. Each action only ever changes the account of the person who asked
(pkexec says who that is), except `user add|remove|list`, which administrators use to manage accounts.
  mwx7-admin autologin on|off      start straight to this person's desktop when the PC starts (off: logon screen)
  mwx7-admin password              set a new password, read from standard input
  mwx7-admin nopassword            remove the password (the logon screen lets this account straight in)
  mwx7-admin password-change       change the password: the current one, then the new one (two lines on standard input); the
                                   current one is checked with PAM first
  mwx7-admin user list             the accounts that sign in: name, full name, standard|admin (tab-separated)
  mwx7-admin user add NAME standard|admin   new account; full name and password come as two lines on standard input
                                   (administrators only)
  mwx7-admin user remove NAME keep|delete   remove an account, keeping its files in /home or deleting them
                                   (administrators only; never yourself, anyone signed in, or the last administrator)
  mwx7-admin picture FILE          the account picture (logon screen, lock screen, Start menu)
  mwx7-admin recovery-prepare      completes the recovery copy (downloads MWX 7 once on PCs set up before it existed)
  mwx7-admin printer discover      list printers found on the network and USB (tab-separated: URI, name)
  mwx7-admin printer add NAME URI  add a driverless (IPP Everywhere) printer; NAME is letters, numbers, - and _
  mwx7-admin printer default NAME  make it the default printer
  mwx7-admin printer remove NAME   remove it
  mwx7-admin nvidia install|remove the NVIDIA driver from Debian's non-free components (a restart finishes it)
  mwx7-admin reset [keep]          Reset MWX 7: reinstalled from the newest ISO on GitHub at this PC's version, then a
                                   restart. Plain: absolutely clean (the first-start setup runs and offers the newest
                                   version). keep: accounts, files, apps and settings stay
  mwx7-admin keep-previous         after MWX 7 went back to the version before an update by itself: keep that version
  mwx7-admin backup run UUID       Settings -> Backup: back up /home to the external drive with that file system UUID
  mwx7-admin backup schedule off|daily|weekly [UUID]   the automatic backup (a systemd timer)
  mwx7-admin backup drives         the drives a backup can go to (UUID, device, size, file system, name)
  mwx7-admin versions on|off|delete-all   Settings -> Backup: keep previous versions of my files (hourly btrfs snapshots of
                                   /home), or delete them all
  mwx7-admin flatpak setup       adds the Flathub remote (system-wide) if it is missing and makes Flatpak apps use the MWX7 theme
  mwx7-admin flatpak install REF   Get Apps: installs a Flathub app for everyone (REF is a plain Flatpak app id, from flathub only)
  mwx7-admin flatpak remove REF    removes it again
  mwx7-admin flatpak update        updates every installed Flatpak app and runtime
  mwx7-admin power button ACTION   Settings -> Power: what the power button does (poweroff, suspend, ignore)
  mwx7-admin power lid ACTION      what closing the lid does (suspend, poweroff, lock, ignore)
  mwx7-admin firewall on|off       Settings -> Security: the firewall (ufw: nothing unasked comes in, everything goes out)
  mwx7-admin autoupdates on|off    install security updates by themselves
  mwx7-admin locale set|add LOCALE  Settings -> Language & region: set the system language, or only make that locale
                                   available (LOCALE like ro_RO.UTF-8; must be one glibc supports; generated if missing)
  mwx7-admin cleanup apt|flatpak   Settings -> Storage: empty the package cache / remove Flatpak runtimes nothing uses
"""
import ctypes
import ctypes.util
import glob
import grp
import os
import pwd
import re
import shutil
import subprocess
import sys
import time

GREETD = '/etc/greetd/config.toml'
# A person's login name: what useradd accepts and what the logon screen shows, nothing that could be read as an option.
USERNAME = re.compile(r'[a-z_][a-z0-9_-]{0,31}\Z')
# Same groups as the first-start setup gives the first account (oobe/install.py GROUPS); "sudo" only for administrators.
USER_GROUPS = ('cdrom', 'audio', 'dip', 'video', 'render', 'input', 'plugdev', 'netdev', 'users', 'lpadmin')
# Get Apps may install any app from Flathub, so the id is checked strictly instead of listed: a reverse-DNS style Flatpak id
# (letters, digits, _ . -), at least one dot, not starting with - or ., and it is only ever passed as one argument to the
# `flathub` remote that this script itself adds.
FLATPAK_ID = re.compile(r'[A-Za-z0-9_][A-Za-z0-9_.-]{1,199}\Z')
FLATHUB_URL = 'https://dl.flathub.org/repo/flathub.flatpakrepo'


def main():
    uid = os.environ.get('PKEXEC_UID')
    if os.geteuid() != 0 or not uid:
        sys.exit('run through pkexec')
    user = pwd.getpwuid(int(uid)).pw_name
    cmd = sys.argv[1:]
    if cmd[:1] == ['autologin'] and cmd[1:] in (['on'], ['off']):
        write_greetd(user if cmd[1] == 'on' else None)
    elif cmd == ['password']:
        new = sys.stdin.readline().rstrip('\n')
        if not new:
            sys.exit('empty password')
        subprocess.run(['chpasswd'], input=f'{user}:{new}\n', text=True, check=True)
    elif cmd == ['password-change']:
        old, new = sys.stdin.readline().rstrip('\n'), sys.stdin.readline().rstrip('\n')
        check_password_text(new)
        if not pam_check(user, old):
            time.sleep(1)  # a wrong guess is not answered faster than once a second
            sys.exit('The current password is not right.')
        subprocess.run(['chpasswd'], input=f'{user}:{new}\n', text=True, check=True)
    elif cmd[:2] == ['user', 'list'] and len(cmd) == 2:
        for name, full, admin in accounts():
            print(f"{name}\t{full}\t{'admin' if admin else 'standard'}")
    elif cmd[:2] == ['user', 'add'] and len(cmd) == 4 and cmd[3] in ('standard', 'admin'):
        require_admin(user)
        user_add(cmd[2], cmd[3] == 'admin')
    elif cmd[:2] == ['user', 'remove'] and len(cmd) == 4 and cmd[3] in ('keep', 'delete'):
        require_admin(user)
        user_remove(user, cmd[2], cmd[3] == 'delete')
    elif cmd == ['nopassword']:
        subprocess.run(['passwd', '-d', user], check=True, capture_output=True)
    elif cmd[:1] == ['picture'] and len(cmd) == 2:
        src = os.path.realpath(cmd[1])
        if not (src.startswith('/usr/share/mwx7/avatars/') or src.startswith(pwd.getpwnam(user).pw_dir + '/')):
            sys.exit('pictures come from MWX 7 or your own folders')
        os.makedirs('/var/lib/AccountsService/icons', exist_ok=True)
        shutil.copyfile(src, f'/var/lib/AccountsService/icons/{user}')
        os.chmod(f'/var/lib/AccountsService/icons/{user}', 0o644)
    elif cmd[:1] == ['printer'] and len(cmd) >= 2:
        printer(cmd[1:])
    elif cmd in (['nvidia', 'install'], ['nvidia', 'remove']):
        nvidia(cmd[1] == 'install')
    elif cmd == ['recovery-prepare'] and os.path.exists('/etc/mwx7/installed'):
        os.execv('/usr/bin/python3', ['python3', '/usr/share/mwx7/oobe/install.py', 'recovery', 'prepare'])
    elif cmd in (['reset'], ['reset', 'keep']) and os.path.exists('/etc/mwx7/installed'):
        reset(keep=cmd[1:] == ['keep'])
    elif cmd == ['keep-previous'] and os.path.exists('/etc/mwx7/installed'):
        os.execv('/usr/bin/python3', ['python3', '/usr/share/mwx7/oobe/install.py', 'keep-previous'])
    elif cmd[:1] == ['backup'] and len(cmd) >= 2 and os.path.exists('/etc/mwx7/installed'):
        # mwx7-backup checks every argument itself (a drive's UUID only, never a path).
        os.execv('/usr/share/mwx7/bin/mwx7-backup', ['mwx7-backup'] + cmd[1:])
    elif cmd[:1] == ['versions'] and len(cmd) == 2 and cmd[1] in ('on', 'off', 'delete-all') and os.path.exists('/etc/mwx7/installed'):
        os.execv('/usr/share/mwx7/bin/mwx7-snapshots', ['mwx7-snapshots', cmd[1]])
    elif cmd[:1] == ['flatpak'] and (cmd[1:] in (['setup'], ['update']) or (len(cmd) == 3 and cmd[1] in ('install', 'remove'))):
        flatpak(cmd[1], cmd[2] if len(cmd) == 3 else None)
    elif cmd[:1] == ['power'] and len(cmd) == 3 and cmd[1] in POWER_KEYS and cmd[2] in POWER_KEYS[cmd[1]][1]:
        power(cmd[1], cmd[2])
    elif cmd[:1] == ['firewall'] and cmd[1:] in (['on'], ['off']):
        firewall(cmd[1] == 'on')
    elif cmd[:1] == ['autoupdates'] and cmd[1:] in (['on'], ['off']):
        # Written last (99): it wins over the 20auto-upgrades that MWX 7 ships, which then never has to be edited.
        with open(AUTOUPDATES + '.tmp', 'w') as f:
            f.write(f'// Written by Settings -> Security.\nAPT::Periodic::Unattended-Upgrade "{1 if cmd[1] == "on" else 0}";\n')
        os.replace(AUTOUPDATES + '.tmp', AUTOUPDATES)
    elif cmd[:1] == ['locale'] and len(cmd) == 3 and cmd[1] in ('set', 'add'):
        locale_cmd(cmd[1], cmd[2])
    elif cmd in (['cleanup', 'apt'], ['cleanup', 'flatpak']):
        if cmd[1] == 'apt':
            subprocess.run(['apt-get', 'clean'], check=True)
        else:
            flatpak('unused', None)
    else:
        sys.exit(__doc__)


# Settings -> Language & region. The locale name is checked twice: against a strict pattern, then against the list glibc
# ships (SUPPORTED), so nothing but a line of that list can ever reach /etc/locale.gen.
LOCALE_NAME = re.compile(r'[a-z]{2,3}_[A-Z]{2}\.UTF-8\Z')


def locale_cmd(action, name):
    if not LOCALE_NAME.match(name):
        sys.exit('not a locale name')
    wanted = f'{name} UTF-8'
    try:
        supported = {l.split('#')[0].strip() for l in open('/usr/share/i18n/SUPPORTED', encoding='utf-8')}
    except OSError:
        supported = set()
    if wanted not in supported:
        sys.exit('this language is not supported')
    norm = name.replace('.UTF-8', '.utf8')
    have = subprocess.run(['locale', '-a'], capture_output=True, text=True).stdout.split()
    if norm not in have:
        gen = '/etc/locale.gen'
        lines = open(gen, encoding='utf-8').read().splitlines() if os.path.exists(gen) else []
        # Uncomment the exact line if it is there, else add it; every other line stays as it was.
        if not any(l.strip() == wanted for l in lines):
            hit = [i for i, l in enumerate(lines) if re.fullmatch(r'#\s*' + re.escape(wanted), l.strip())]
            if hit:
                lines[hit[0]] = wanted
            else:
                lines.append(wanted)
            with open(gen + '.tmp', 'w', encoding='utf-8') as f:
                f.write('\n'.join(lines) + '\n')
            os.replace(gen + '.tmp', gen)
        subprocess.run(['locale-gen'], check=True, stdout=subprocess.DEVNULL)
    if action == 'set':
        subprocess.run(['update-locale', f'LANG={name}'], check=True)


# Settings -> Power: logind reads a drop-in of ours, so the vendor files are never edited. Each setting is a fixed key with a
# fixed list of values (nothing from the caller reaches the file as text).
LOGIND_DROPIN = '/etc/systemd/logind.conf.d/50-mwx7-power.conf'
POWER_KEYS = {'button': (['HandlePowerKey'], ['poweroff', 'suspend', 'ignore']),
              'lid': (['HandleLidSwitch', 'HandleLidSwitchExternalPower', 'HandleLidSwitchDocked'],
                      ['suspend', 'poweroff', 'lock', 'ignore'])}
AUTOUPDATES = '/etc/apt/apt.conf.d/99mwx7-autoupdates'


def power(what, action):
    values = {}
    try:
        for line in open(LOGIND_DROPIN):
            k, _, v = line.strip().partition('=')
            if k and not k.startswith(('#', '[')):
                values[k] = v
    except OSError:
        pass
    for key in POWER_KEYS[what][0]:
        values[key] = action
    os.makedirs(os.path.dirname(LOGIND_DROPIN), exist_ok=True)
    with open(LOGIND_DROPIN + '.tmp', 'w') as f:
        f.write('# Written by MWX 7 (Settings -> Power).\n[Login]\n' + ''.join(f'{k}={v}\n' for k, v in sorted(values.items())))
    os.chmod(LOGIND_DROPIN + '.tmp', 0o644)
    os.replace(LOGIND_DROPIN + '.tmp', LOGIND_DROPIN)
    # logind re-reads its configuration on SIGHUP (a plain reload is not supported for it).
    subprocess.run(['systemctl', 'kill', '-s', 'HUP', 'systemd-logind.service'], check=False)


def firewall(on):
    """ufw is the firewall. The older nftables rules that MWX 7 started with are retired when ufw takes over (they would
    flush ufw's rules at start) and when the firewall is switched off (they would keep blocking)."""
    def ufw(*a):
        subprocess.run(['ufw', *a], check=True, capture_output=True)
    if on:
        subprocess.run(['systemctl', 'disable', '--now', 'nftables.service'], check=False, capture_output=True)
        ufw('default', 'deny', 'incoming')
        ufw('default', 'allow', 'outgoing')
        ufw('--force', 'enable')
    else:
        ufw('disable')
        subprocess.run(['systemctl', 'disable', '--now', 'nftables.service'], check=False, capture_output=True)

def write_greetd(autologin_user):
    text = ('# Written by MWX 7 (first-start setup, Settings -> Account).\n[terminal]\nvt = 1\n\n'
            '[default_session]\ncommand = "/usr/local/bin/mwx7-greeter-session"\nuser = "_greetd"\n')
    if autologin_user:
        text += f'\n[initial_session]\ncommand = "/usr/local/bin/mwx7-session"\nuser = "{autologin_user}"\n'
    with open(GREETD + '.tmp', 'w') as f:
        f.write(text)
    os.chmod(GREETD + '.tmp', 0o644)
    os.replace(GREETD + '.tmp', GREETD)


def check_password_text(pw):
    # chpasswd reads one "name:password" line, so a line break (or NUL) could never be part of one.
    if not pw or len(pw) > 256 or '\n' in pw or '\r' in pw or '\0' in pw:
        sys.exit('That password cannot be used.')


def pam_check(name, password):
    """True when PAM (the lock screen's own service: the same checks as signing in) accepts this password for this account.
    Done through libpam directly, because python's crypt module is gone and unix_chkpwd is not a public interface."""
    libpam = ctypes.CDLL(ctypes.util.find_library('pam') or 'libpam.so.0')
    libc = ctypes.CDLL(None)
    libc.calloc.restype = ctypes.c_void_p
    libc.strdup.restype = ctypes.c_void_p

    class Msg(ctypes.Structure):
        _fields_ = [('style', ctypes.c_int), ('msg', ctypes.c_char_p)]

    class Resp(ctypes.Structure):
        _fields_ = [('resp', ctypes.c_void_p), ('retcode', ctypes.c_int)]

    conv_t = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_int, ctypes.POINTER(ctypes.POINTER(Msg)),
                              ctypes.POINTER(ctypes.POINTER(Resp)), ctypes.c_void_p)

    class Conv(ctypes.Structure):
        _fields_ = [('conv', conv_t), ('data', ctypes.c_void_p)]
    pw = password.encode()

    def talk(n, msgs, out, _data):
        # PAM frees this array and the strings itself; styles 1 and 2 are the password prompts.
        arr = libc.calloc(n, ctypes.sizeof(Resp))
        resp = ctypes.cast(arr, ctypes.POINTER(Resp))
        for i in range(n):
            if msgs[i].contents.style in (1, 2):
                resp[i].resp = libc.strdup(pw)
        out[0] = resp
        return 0
    cb = conv_t(talk)
    handle = ctypes.c_void_p()
    conv = Conv(cb, None)
    libpam.pam_start.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.POINTER(Conv), ctypes.POINTER(ctypes.c_void_p)]
    libpam.pam_authenticate.argtypes = [ctypes.c_void_p, ctypes.c_int]
    libpam.pam_end.argtypes = [ctypes.c_void_p, ctypes.c_int]
    if libpam.pam_start(b'mwx7-lock', name.encode(), ctypes.byref(conv), ctypes.byref(handle)) != 0:
        sys.exit('Could not check the password.')
    code = libpam.pam_authenticate(handle, 0)
    libpam.pam_end(handle, code)
    return code == 0


def in_group(name, group):
    try:
        g = grp.getgrnam(group)
        return name in g.gr_mem or pwd.getpwnam(name).pw_gid == g.gr_gid
    except KeyError:
        return False


def accounts():
    """People's accounts: ids from 1000 up with a login shell (system accounts and 'nobody' have neither)."""
    out = []
    for e in pwd.getpwall():
        if 1000 <= e.pw_uid < 60000 and not e.pw_shell.endswith(('nologin', 'false')):
            out.append((e.pw_name, (e.pw_gecos or '').split(',')[0].replace('\t', ' '), in_group(e.pw_name, 'sudo')))
    return sorted(out)


def require_admin(caller):
    if not in_group(caller, 'sudo'):
        sys.exit('Only an administrator can add or remove accounts.')


def user_add(name, admin):
    if not USERNAME.match(name):
        sys.exit('The account name needs lowercase letters, digits, - and _ (starting with a letter), up to 32.')
    try:
        pwd.getpwnam(name)
        sys.exit('An account with that name exists already.')
    except KeyError:
        pass
    if name in ('root', 'nobody') or any(g.gr_name == name for g in grp.getgrall()):
        sys.exit('That name is taken.')
    full = sys.stdin.readline().rstrip('\n').strip()
    pw = sys.stdin.readline().rstrip('\n')
    if len(full) > 64 or any(c in full for c in ':,\\\0') or not full.isprintable():
        sys.exit('That full name cannot be used.')
    check_password_text(pw)
    groups = [g for g in USER_GROUPS + (('sudo',) if admin else ()) if any(x.gr_name == g for x in grp.getgrall())]
    subprocess.run(['useradd', '-m', '-s', '/bin/bash', '-c', full or name, '-G', ','.join(groups), name],
                   check=True, capture_output=True)
    r = subprocess.run(['chpasswd'], input=f'{name}:{pw}\n', text=True, capture_output=True)
    if r.returncode != 0:
        subprocess.run(['userdel', '-r', name], capture_output=True)
        sys.exit('Could not set the password.')


def user_remove(caller, name, delete_files):
    if not USERNAME.match(name):
        sys.exit('Not an account name.')
    try:
        e = pwd.getpwnam(name)
    except KeyError:
        sys.exit('There is no such account.')
    if name == caller:
        sys.exit('You cannot remove the account you are using.')
    if not (1000 <= e.pw_uid < 60000):
        sys.exit('That is not a person\'s account.')
    sessions = subprocess.run(['loginctl', 'list-users', '--no-legend'], capture_output=True, text=True).stdout
    if any(ln.split()[:1] == [str(e.pw_uid)] for ln in sessions.splitlines()):
        sys.exit(f'{name} is signed in right now. Sign them out first.')
    try:
        if f'user = "{name}"' in open(GREETD).read().split('[initial_session]', 1)[1]:
            write_greetd(None)  # otherwise the PC would start to a desktop that is gone
    except (OSError, IndexError):
        pass
    subprocess.run(['userdel'] + (['-r'] if delete_files else []) + [name], check=True, capture_output=True)
    try:
        os.unlink(f'/var/lib/AccountsService/icons/{name}')
    except OSError:
        pass


# Everything that reaches lpadmin is checked here: the queue name is plain, the address is an IPP/DNS-SD one and cannot be
# read as an option (no shell is used either, only argument lists).
PRINTER_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9_-]{0,39}\Z')
PRINTER_URI = re.compile(r'(ipps?|dnssd)://[A-Za-z0-9._~%:/?=&@+\[\]-]{1,300}\Z')


def printer(args):
    op = args[0]
    if op == 'discover' and len(args) == 1:
        out = subprocess.run(['lpinfo', '-l', '-v'], capture_output=True, text=True, timeout=60).stdout
        for block in out.split('Device:')[1:]:
            fields = dict(ln.strip().split(' = ', 1) for ln in block.splitlines() if ' = ' in ln)
            uri = fields.get('uri', '')
            if PRINTER_URI.match(uri):
                print(f"{uri}\t{(fields.get('info') or fields.get('make-and-model') or uri).replace(chr(9), ' ')}")
    elif op == 'add' and len(args) == 3 and PRINTER_NAME.match(args[1]) and PRINTER_URI.match(args[2]):
        subprocess.run(['lpadmin', '-p', args[1], '-E', '-v', args[2], '-m', 'everywhere'], check=True, timeout=120)
    elif op in ('default', 'remove') and len(args) == 2 and PRINTER_NAME.match(args[1]):
        subprocess.run(['lpadmin', '-d' if op == 'default' else '-x', args[1]], check=True, timeout=60)
    else:
        sys.exit(__doc__)


def enable_non_free():
    """Debian's own sources only: add contrib and non-free to the one-line and the deb822 forms."""
    for path in ['/etc/apt/sources.list'] + glob.glob('/etc/apt/sources.list.d/*.sources'):
        try:
            old = open(path).read()
        except OSError:
            continue
        lines = old.split('\n')
        deb822 = path.endswith('.sources')
        debian = deb822 and any(l.startswith('URIs:') and 'debian.org' in l for l in lines)
        for i, l in enumerate(lines):
            if (deb822 and debian and l.startswith('Components:')) or (
                    not deb822 and re.match(r'deb\s', l) and 'debian.org' in l):
                lines[i] = l + ''.join(f' {c}' for c in ('contrib', 'non-free') if c not in l.split())
        if '\n'.join(lines) != old:
            with open(path + '.tmp', 'w') as f:
                f.write('\n'.join(lines))
            os.replace(path + '.tmp', path)


NVIDIA_CONF = '/etc/modprobe.d/mwx7-nvidia.conf'


def secure_boot_on():
    r = subprocess.run(['mokutil', '--sb-state'], capture_output=True, text=True)
    return 'enabled' in r.stdout.lower()


def nvidia(install):
    env = dict(os.environ, DEBIAN_FRONTEND='noninteractive')
    if install:
        enable_non_free()
        subprocess.run(['apt-get', 'update'], check=True, env=env)
        # The kernel module is built on this PC (DKMS), which needs the headers of the installed kernel; the headers
        # metapackage follows linux-image-amd64, so they always match it.
        subprocess.run(['apt-get', 'install', '-y', 'linux-headers-amd64', 'dkms', 'nvidia-driver', 'firmware-misc-nonfree'],
                       check=True, env=env)
        # Wayfire needs the driver's kernel modesetting (and its framebuffer) to get a screen at all.
        with open(NVIDIA_CONF, 'w') as f:
            f.write('# MWX 7: Wayland needs kernel modesetting with the NVIDIA driver.\noptions nvidia-drm modeset=1 fbdev=1\n')
        subprocess.run(['update-initramfs', '-u'], check=True, env=env)
        if secure_boot_on() and os.path.exists('/var/lib/dkms/mok.pub'):
            # Unsigned kernel modules are refused with Secure Boot on, so the driver would never load. Queue DKMS's signing
            # key for enrollment: at the next start a blue screen (MOK manager) asks for this one-time password. Enrolling
            # needs the person at the screen, which is exactly the point of it. Failure is not fatal: Settings explains.
            subprocess.run(['mokutil', '--import', '/var/lib/dkms/mok.pub'], input='mwx7mwx7\nmwx7mwx7\n', text=True,
                           capture_output=True)
    else:
        # Only the driver goes: the firmware package is harmless and other hardware may use it.
        subprocess.run(['apt-get', 'remove', '--purge', '-y', 'nvidia-driver'], check=True, env=env)
        if os.path.exists(NVIDIA_CONF):
            os.unlink(NVIDIA_CONF)
            subprocess.run(['update-initramfs', '-u'], check=False, env=env)


def reset(keep):
    # The work is the setup's own installer, which knows how MWX 7 is put on a disk. Its progress lines go straight
    # through to Settings.
    os.execv('/usr/bin/python3', ['python3', '/usr/share/mwx7/oobe/install.py', 'reinstall', 'keep' if keep else 'clean'])


def flatpak(action, ref):
    # Plain, parseable output: Get Apps reads the progress lines (percentages) from stdout.
    env = dict(os.environ, LC_ALL='C', LANG='C')

    def run(*a):
        return subprocess.run(['flatpak', *a], env=env, stdin=subprocess.DEVNULL, stderr=subprocess.STDOUT).returncode
    if ref is not None and not (FLATPAK_ID.match(ref) and '.' in ref):
        sys.exit(f'{ref!r} is not a valid Flatpak app id')
    # Always make sure Flathub is there, so the first install on a fresh PC needs no separate step.
    code = run('remote-add', '--system', '--if-not-exists', 'flathub', FLATHUB_URL)
    # Flatpak apps look like MWX 7's: they may read ~/.themes (where the session keeps a copy of the MWX7 theme) and are told
    # to use it. Fonts need nothing: Flatpak already shows the host's /usr/share/fonts and fontconfig (Selawik) to apps.
    if code == 0:
        code = run('override', '--system', '--filesystem=~/.themes:ro', '--filesystem=xdg-data/themes:ro', '--env=GTK_THEME=MWX7')
    if code == 0 and action == 'install':
        code = run('install', '--system', '--noninteractive', '-y', 'flathub', ref)
    elif code == 0 and action == 'update':
        code = run('update', '--system', '--noninteractive', '-y')
    elif code == 0 and action == 'remove':
        code = run('uninstall', '--system', '--noninteractive', '-y', ref)
    elif code == 0 and action == 'unused':
        code = run('uninstall', '--system', '--unused', '--noninteractive', '-y')
    sys.exit(code)


main()
