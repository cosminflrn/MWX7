#!/bin/sh
# The first sign-in of each account, as MWX 7 on the web: a "Welcome" card and the Welcome tour (the web concept's
# Welcome app). Once per account; the tour is always in the Start menu afterwards.
DONE="${XDG_CONFIG_HOME:-$HOME/.config}/mwx7/welcomed"
[ -e "$DONE" ] && exit 0
mkdir -p "$(dirname "$DONE")" && : > "$DONE"
sleep 4
name=$(getent passwd "$(id -un)" | cut -d: -f5 | cut -d, -f1)
notify-send -a "MWX 7" -i /usr/share/mwx7/icons/orb.png "Welcome, ${name:-$(id -un)}" \
  "Click the orb to start, or the magnifier to search." &
exec /usr/share/mwx7/bin/mwx7-app welcome
