#!/bin/sh
# Autostarted at every sign-in (wayfire.ini). The Welcome Center shows at an account's first sign-in, and at later ones only
# when "Show at startup" is ticked in it (stored in ~/.config/mwx7/welcome.json). It is always in the Start menu.
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/mwx7"
DONE="$CONF/welcomed"
first=0
if [ ! -e "$DONE" ]; then
  first=1
  mkdir -p "$CONF" && : > "$DONE"
elif ! python3 -c "import json,sys; sys.exit(0 if json.load(open('$CONF/welcome.json')).get('show_at_startup') else 1)" 2>/dev/null; then
  exit 0
fi
sleep 4
if [ "$first" = 1 ]; then
  name=$(getent passwd "$(id -un)" | cut -d: -f5 | cut -d, -f1)
  notify-send -a "MWX 7" -i /usr/share/mwx7/icons/orb.png "Welcome, ${name:-$(id -un)}" \
    "Start is the orb in the dock; Super+S searches everything." &
fi
exec /usr/share/mwx7/bin/mwx7-app welcome
