#!/bin/sh
# The MWX 7 desktop session: Wayfire with MWX 7's config. The shell, wallpaper and portals start from its autostart.
export XDG_CURRENT_DESKTOP=MWX7:wlroots
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=mwx7
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM='wayland;xcb'
export GDK_BACKEND='wayland,x11'
# Software rendering is allowed so a VM without 3D still gets a desktop (slower, but never a black screen).
# GTK apps under Wayland don't reliably pick the theme up from GSettings (no GNOME settings daemon here), so name it
# directly. The MWX7 theme has gtk-3.0 and gtk-4.0 parts, so GTK 3 and GTK 4 apps (GIMP, LibreOffice, Firefox) match.
export GTK_THEME=MWX7
# Qt apps (VLC, OBS) take their colours, fonts and look from GTK through qt5/qt6-gtk-platformtheme.
export QT_QPA_PLATFORMTHEME=gtk3
# Flatpak sandboxes cannot see /usr/share/themes, but they can see ~/.themes (mwx7-admin flatpak setup lets them); keep a
# copy of the theme there, refreshed when an update changes it.
if ! cmp -s /usr/share/themes/MWX7/gtk-4.0/gtk.css "$HOME/.themes/MWX7/gtk-4.0/gtk.css" 2>/dev/null ||
   ! cmp -s /usr/share/themes/MWX7/gtk-3.0/gtk.css "$HOME/.themes/MWX7/gtk-3.0/gtk.css" 2>/dev/null; then
  mkdir -p "$HOME/.themes" && rm -rf "$HOME/.themes/MWX7" && cp -r /usr/share/themes/MWX7 "$HOME/.themes/MWX7" || true
fi
export WLR_RENDERER_ALLOW_SOFTWARE=1
# Apps installed with Get Apps (Flatpak) put their menu entries and icons here; without it they never show up in Start.
# (Spelled out with the defaults, since naming the variable at all replaces them.)
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:/var/lib/flatpak/exports/share:$HOME/.local/share/flatpak/exports/share"
export WLR_NO_HARDWARE_CURSORS=1
# Settings -> Language & region writes date/number formats (LC_TIME=ro_RO.UTF-8 ...) to an environment.d drop-in. The session
# is not started by systemd's user manager, so read it here; only plain LC_* lines are taken, nothing else is evaluated.
REGION="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d/50-mwx7-region.conf"
if [ -f "$REGION" ]; then
  while IFS='=' read -r k v; do
    case "$k" in LC_TIME|LC_NUMERIC|LC_MONETARY|LC_PAPER|LC_MEASUREMENT)
      case "$v" in *[!A-Za-z0-9_.@-]*|'') ;; *) export "$k=$v" ;; esac ;;
    esac
  done < "$REGION"
fi
# GTK 4's default GPU renderer misdraws in VMware/VirtualBox with 3D on; its older GL renderer is reliable there.
if [ "$(systemd-detect-virt 2>/dev/null)" != none ]; then export GSK_RENDERER=gl; fi
# Each user gets their own copy of the MWX 7 Wayfire config, which MWX 7 Settings edits; Wayfire reloads it live.
# Documents, Downloads, Music, Pictures, Videos, Desktop: created on first login, and Files and Chrome know them.
xdg-user-dirs-update >/dev/null 2>&1 || true
# The same folders in the Files sidebar, under Places (only the first time, so the person's own changes stay).
if [ ! -f "$HOME/.config/gtk-3.0/bookmarks" ]; then
  mkdir -p "$HOME/.config/gtk-3.0"
  . "${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs" 2>/dev/null || true
  for d in "$XDG_DOCUMENTS_DIR" "$XDG_DOWNLOAD_DIR" "$XDG_MUSIC_DIR" "$XDG_PICTURES_DIR" "$XDG_VIDEOS_DIR"; do
    [ -d "$d" ] && printf 'file://%s\n' "$d"
  done > "$HOME/.config/gtk-3.0/bookmarks"
fi
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/mwx7"
mkdir -p "$CONF"
# A copy from another MWX 7 release is rebuilt from the current defaults, keeping what was chosen in Settings.
/usr/share/mwx7/bin/mwx7-config-merge "$CONF/wayfire.ini" || [ -f "$CONF/wayfire.ini" ] || cp /etc/mwx7/wayfire.ini "$CONF/wayfire.ini"
# Wayfire's log goes to a file, not to the console that is visible for the second before the first frame.
LOG="${XDG_RUNTIME_DIR:-/tmp}/wayfire.log"
# The last session's log survives a crash, for finding out what happened.
[ -f "$LOG" ] && mv -f "$LOG" "${LOG%.log}.old.log"
# VMware's 3D driver (vmwgfx): Xwayland's GL acceleration (glamor) crashed it as soon as an X11 app like VLC drew
# ("The X11 connection broke"); X11 apps draw in software there instead. Wayland apps keep the GPU.
for drv in /sys/class/drm/card*/device/driver; do
  if [ "$(basename "$(readlink -f "$drv")")" = vmwgfx ]; then
    export XWAYLAND_NO_GLAMOR=1
    # VMware Workstation's cursor plane with atomic modesetting makes the pointer lag and stutter (KDE bug 478487,
    # same on wlroots): draw the cursor ourselves and use legacy modesetting. Hovering and dragging felt slow here.
    export WLR_NO_HARDWARE_CURSORS=1 WLR_DRM_NO_ATOMIC=1
  fi
done
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
  exec dbus-run-session -- wayfire -c "$CONF/wayfire.ini" > "$LOG" 2>&1
fi
exec wayfire -c "$CONF/wayfire.ini" > "$LOG" 2>&1
